{
  "obsidian_cli": "D:/softwares/obsidian/Obsidian.com",
  "vault_name": "Design",
  "godot_exe": "<your_godot_console_exe_path>",
  "design_dir": "Design",
  "moonshot_api_key": "<your_moonshot_api_key_or_empty>",
  "deploy": {
    "ssh_target": "<ssh_user>@<server_ip_or_domain>",
    "remote_root": "/var/www/games",
    "url_root": "https://<server_ip_or_domain>",
    "game_name": "<your_game_name>",
    "export_preset": "Web"
  },
  "explore": {
    "design_repo_url": "https://github.com/<org>/<design-repo>.git",
    "explore_dir": "Design/_explore",
    "trigger_id": "<remote_trigger_id_or_empty>",
    "trigger_name": "<trigger display name, e.g. 夜间设计探索 — your-project>",
    "environment_id": "<env_id_or_empty>",
    "cron": "0 18 * * *",
    "model": "claude-sonnet-4-6",
    "lock_tag_default": "模块/前端表现",
    "round_budget_minutes": 45,
    "websearch_limit": 6
  }
}
